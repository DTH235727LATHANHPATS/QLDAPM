@model tps.Models.Entities.PhongTro
@{
    ViewData["Title"] = Model.TenNhaTro;
}

<a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-3">← Quay lại danh sách</a>

@if (TempData["Loi"] != null)
{
    <div class="alert alert-danger">@TempData["Loi"]</div>
}
@if (TempData["ThanhCong"] != null)
{
    <div class="alert alert-success">@TempData["ThanhCong"]</div>
}

<div class="row">
    <div class="col-md-6 mb-3">
        @if (!string.IsNullOrEmpty(Model.HinhAnh))
        {
            <img src="@Model.HinhAnh" class="img-fluid rounded" alt="@Model.TenNhaTro" />
        }
        else
        {
            <div class="bg-light text-muted d-flex align-items-center justify-content-center rounded" style="height:300px">Chưa có ảnh</div>
        }
    </div>

    <div class="col-md-6">
        <h2>@Model.TenNhaTro</h2>
        <p class="text-muted">@Model.DiaChi</p>
        <h3 class="text-danger">@Model.GiaThue.ToString("N0") đ/tháng</h3>

        <p>
            <span class="badge bg-secondary">@Model.LoaiPhong.Ten</span>
            @if (Model.ConPhong)
            {
                <span class="badge bg-success">Còn phòng</span>
            }
            else
            {
                <span class="badge bg-dark">Hết phòng</span>
            }
            @if (Model.TimOGhep)
            {
                <span class="badge bg-info text-dark">Đang tìm người ở ghép</span>
            }
        </p>

        <table class="table table-sm">
            <tr><th style="width:40%">Diện tích</th><td>@Model.DienTich m²</td></tr>
            <tr><th>Tiền cọc</th><td>@(Model.TienCoc.HasValue? Model.TienCoc.Value.ToString("N0") + " đ" : "Chưa cập nhật")</td></tr>
            <tr><th>Giá điện</th><td>@(Model.GiaDien.HasValue? Model.GiaDien.Value.ToString("N0") + " đ/kWh" : "Chưa cập nhật")</td></tr>
            <tr><th>Giá nước</th><td>@(Model.GiaNuoc.HasValue? Model.GiaNuoc.Value.ToString("N0") + " đ" : "Chưa cập nhật")</td></tr>
        </table>

        @if (!string.IsNullOrWhiteSpace(Model.MoTa))
        {
            <h5>Mô tả</h5>
            <p style="white-space:pre-line">@Model.MoTa</p>
        }

        @if (Model.TimOGhep && Model.ConPhong && User.IsInRole("SinhVien"))
        {
            <a asp-controller="GhepPhong" asp-action="GuiYeuCau" asp-route-phongId="@Model.Id"
               class="btn btn-success mb-3">Gửi yêu cầu ở ghép</a>
        }

        <div class="card card-body bg-light">
            <h5>Liên hệ chủ trọ</h5>
            <p class="mb-1">@Model.ChuTro.HoTen</p>
            @if (!string.IsNullOrEmpty(Model.ChuTro.SoDienThoai))
            {
                <p class="mb-1">SĐT: @Model.ChuTro.SoDienThoai</p>
            }
            @if (!string.IsNullOrEmpty(Model.ChuTro.Email))
            {
                <p class="mb-0">Email: @Model.ChuTro.Email</p>
            }
        </div>
    </div>
</div>