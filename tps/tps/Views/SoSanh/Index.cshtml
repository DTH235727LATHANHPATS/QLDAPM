@model List<tps.Models.Entities.PhongTro>
@{
    ViewData["Title"] = "So sánh phòng";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="section-title mb-0">So sánh phòng trọ</h2>
    <div class="d-flex gap-2">
        <a asp-controller="TimKiem" asp-action="Index" class="btn btn-outline-primary">+ Thêm phòng</a>
        @if (Model.Any())
        {
            <form asp-action="XoaTatCa" method="post">
                <button class="btn btn-outline-danger">Xóa tất cả</button>
            </form>
        }
    </div>
</div>

@if (TempData["ThongBaoSoSanh"] != null)
{
    <div class="alert alert-info">@TempData["ThongBaoSoSanh"]</div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-warning">
        Chưa có phòng nào để so sánh. Vào <a asp-controller="TimKiem" asp-action="Index">Tìm phòng</a>,
        bấm nút <strong>So sánh</strong> ở các phòng bạn quan tâm (tối đa 3 phòng).
    </div>
}
else
{
    // Giá trị tốt nhất để tô nổi
    var giaThap = Model.Min(p => p.GiaThue);
    var dtLon = Model.Max(p => p.DienTich);

    <div class="table-responsive">
        <table class="table table-bordered align-middle text-center bg-white">
            <thead class="table-light">
                <tr>
                    <th style="width:18%"></th>
                    @foreach (var p in Model)
                    {
                        <th>
                            <form asp-action="Bo" method="post" class="text-end">
                                <input type="hidden" name="id" value="@p.Id" />
                                <button class="btn btn-sm btn-link text-danger p-0" title="Bỏ khỏi so sánh">✕ Bỏ</button>
                            </form>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th class="text-start">Ảnh</th>
                    @foreach (var p in Model)
                    {
                        <td>
                            @if (!string.IsNullOrEmpty(p.HinhAnh))
                            {
                                <img src="@p.HinhAnh" alt="@p.TenNhaTro" style="width:100%;max-height:150px;object-fit:cover" class="rounded" />
                            }
                            else
                            {

                                <span class="text-muted">Chưa có ảnh</span>
                            }
                        </td>
                    }
                </tr>
                <tr>
                    <th class="text-start">Tên nhà trọ</th>
                    @foreach (var p in Model)
                    {
                        <td><a asp-controller="TimKiem" asp-action="ChiTiet" asp-route-id="@p.Id" class="fw-semibold">@p.TenNhaTro</a></td>
                    }
                </tr>
                <tr>
                    <th class="text-start">Địa chỉ</th>
                    @foreach (var p in Model)
                    {
                        <td>@p.DiaChi</td>
                    }
                </tr>
                <tr>
                    <th class="text-start">Loại phòng</th>
                    @foreach (var p in Model)
                    {
                        <td>@p.LoaiPhong.Ten</td>
                    }
                </tr>
                <tr>
                    <th class="text-start">Giá thuê</th>
                    @foreach (var p in Model)
                    {
                        <td class="@(p.GiaThue == giaThap && Model.Count > 1 ? "table-success fw-bold" : "")">
                            @p.GiaThue.ToString("N0") đ
                            @if (p.GiaThue == giaThap && Model.Count > 1)
                            {
                                <div class="small text-success">Rẻ nhất</div>
                            }
                        </td>
                    }
                </tr>
                <tr>
                    <th class="text-start">Diện tích</th>
                    @foreach (var p in Model)
                    {
                        <td class="@(p.DienTich == dtLon && Model.Count > 1 ? "table-success fw-bold" : "")">
                            @p.DienTich m²
                            @if (p.DienTich == dtLon && Model.Count > 1)
                            {
                                <div class="small text-success">Rộng nhất</div>
                            }
                        </td>
                    }
                </tr>
                <tr>
                    <th class="text-start">Giá / m²</th>
                    @foreach (var p in Model)
                    {
                        <td>@((p.GiaThue / p.DienTich).ToString("N0")) đ</td>
                    }
                </tr>
                <tr>
                    <th class="text-start">Tiền cọc</th>
                    @foreach (var p in Model)
                    {
                        <td>@(p.TienCoc.HasValue? p.TienCoc.Value.ToString("N0") + " đ" : "Chưa cập nhật")</td>
                    }
                </tr>
                <tr>
                    <th class="text-start">Giá điện</th>
                    @foreach (var p in Model)
                    {
                        <td>@(p.GiaDien.HasValue? p.GiaDien.Value.ToString("N0") + " đ/kWh" : "Chưa cập nhật")</td>
                    }
                </tr>
                <tr>
                    <th class="text-start">Giá nước</th>
                    @foreach (var p in Model)
                    {
                        <td>@(p.GiaNuoc.HasValue? p.GiaNuoc.Value.ToString("N0") + " đ" : "Chưa cập nhật")</td>
                    }
                </tr>
                <tr>
                    <th class="text-start">Tình trạng</th>
                    @foreach (var p in Model)
                    {
                        <td>
                            @if (p.ConPhong)
                            {
                                <span class="badge bg-success">Còn phòng</span>
                            }
                            else
                            {

                                <span class="badge bg-secondary">Hết phòng</span>
                            }
                        </td>
                    }
                </tr>
                <tr>
                    <th class="text-start">Tìm ở ghép</th>
                    @foreach (var p in Model)
                    {
                        <td>@(p.TimOGhep ? "Có" : "Không")</td>
                    }
                </tr>
                <tr>
                    <th class="text-start">Chủ trọ</th>
                    @foreach (var p in Model)
                    {
                        <td>
                            @p.ChuTro.HoTen
                            @if (!string.IsNullOrEmpty(p.ChuTro.SoDienThoai))
                            {
                                <div class="small text-muted">@p.ChuTro.SoDienThoai</div>
                            }
                        </td>
                    }
                </tr>
            </tbody>
        </table>
    </div>
}