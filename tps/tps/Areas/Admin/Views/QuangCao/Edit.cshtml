@model tps.Models.ViewModels.QuangCaoFormViewModel
@{
	ViewData["Title"] = "Sửa quảng cáo";
}
<h2 class="mb-3">Sửa quảng cáo</h2>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
	<partial name="_Form" model="Model" />
	<button class="btn btn-primary">Cập nhật</button>
	<a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>
@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}