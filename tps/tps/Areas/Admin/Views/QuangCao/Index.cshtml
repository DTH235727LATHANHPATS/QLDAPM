@model List<tps.Models.Entities.QuangCao>
@{
    ViewData["Title"] = "Quảng cáo";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Quảng cáo</h2>
    <a asp-action="Create" class="btn btn-primary">+ Thêm quảng cáo</a>
</div>
@if (TempData["ThanhCong"] != null)
{
    <div class="alert alert-success">@TempData["ThanhCong"]</div>
}

<table class="table table-bordered align-middle">
    <thead class="table-light"><tr><th>Ảnh</th><th>Tiêu đề</th><th>Vị trí</th><th>Thời gian</th><th>Hiển thị</th><th></th></tr></thead>
    <tbody>
        @foreach (var q in Model)
        {
            <tr>
                <td style="width:110px">@if (!string.IsNullOrEmpty(q.HinhAnh)) {
                <img src="@q.HinhAnh" style="max-width:100px;max-height:60px" alt="" />
            }
</td>
            <td>@q.TieuDe</td>
            <td>@(q.ViTri == 0 ? "Banner trang chủ" : q.ViTri == 1 ? "Cột bên" : "Đầu trang tìm kiếm")</td>
            <td>@q.NgayBatDau.ToString("dd/MM/yyyy") - @(q.NgayKetThuc?.ToString("dd/MM/yyyy") ?? "không giới hạn")</td>
            <td>@(q.HienThi ? "Có" : "Ẩn")</td>
            <td class="text-nowrap">
                <a asp-action="Edit" asp-route-id="@q.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                <form asp-action="Delete" asp-route-id="@q.Id" method="post" class="d-inline" onsubmit="return confirm('Xóa quảng cáo này?');">
                    <button class="btn btn-sm btn-outline-danger">Xóa</button>
                </form>
            </td>
        </tr>
                }
    </tbody>
</table>